# ---- Supabase: server-side only. Never expose the secret key to the browser. ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Set to true only after supabase/migrations 0001-0010 are applied.
NBA_SCHEMA_V2=false

# ---- Pipeline (laptop only) ----
ODDS_API_KEY=your_key_here
NBA_PRODUCTION_MODEL=gradient-boosting-gridsearch

# ---- Notifications (laptop only). All optional: a channel without its variables is skipped and logged. ----
# Picks and results go to a public ntfy topic. The token is only needed for a reserved/protected topic.
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
# The daily summary goes by email over SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---- Flask dashboard ----
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Local laptop only. Never set this on Vercel.
ALLOW_RUN_WORKFLOW=false

# ---- Supabase: server-side only. Never expose the secret key to the browser. ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Set to true only after supabase/migrations 0001-0010 are applied.
NBA_SCHEMA_V2=false

# ---- Pipeline (laptop only) ----
ODDS_API_KEY=your_key_here
NBA_PRODUCTION_MODEL=legacy-calibrated-logistic

# ---- Twilio SMS (laptop only) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_TO=+1XXXXXXXXXX

# ---- Flask dashboard ----
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Local laptop only. Never set this on Vercel.
ALLOW_RUN_WORKFLOW=false
